# Django Core Configuration
DJANGO_SECRET_KEY=django-insecure-aruvi-boutique-luxury-key-2026-v2-secure
DJANGO_DEBUG=True

# PostgreSQL Database Configuration (falls back to SQLite if not provided)
POSTGRES_DB=aruvi_boutique_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Firebase Cloud Storage & Admin SDK
FIREBASE_PROJECT_ID=aruvicollections-5ce06
FIREBASE_STORAGE_BUCKET=aruvicollections-5ce06.firebasestorage.app
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Photo Retention Policy (in days)
PHOTO_RETENTION_DAYS=7

# Celery + Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True
