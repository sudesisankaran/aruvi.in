{
  "name": "aruvi-collections-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Aruvi Collections E-Commerce Application - Frontend (React.js) & Backend (Django REST Framework)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python manage.py runserver 0.0.0.0:8000",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "start": "npm --prefix frontend run dev",
    "test": "node verify-app.mjs"
  },
  "keywords": [
    "react",
    "django",
    "ecommerce",
    "aruvi-collections",
    "boutique"
  ],
  "author": "Aruvi Collections",
  "license": "ISC"
}
